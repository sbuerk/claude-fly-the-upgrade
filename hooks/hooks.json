{
  "description": "Sterile cockpit: while a flight is open, nothing lands on the base branch.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_base_branch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
